# Template for .env. `make env` (run by every make target) writes .env from this file
# and replaces each <generated> value with a random one, so no credential is committed.
# The Makefile includes .env, and every deliverable reads its settings from the
# environment.

# Host ports of the local services started by docker compose. They avoid the
# default ports so the stack can run next to other projects.
POSTGRES_PORT=55432
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
KEYCLOAK_PORT=58080

# PostgreSQL. The superuser runs the init script, which creates the platform and
# keycloak roles with the passwords below. The platform role may create databases
# because the test suite clones one database per test from a migrated template.
POSTGRES_PASSWORD=<generated>
PLATFORM_DB_PASSWORD=<generated>
KEYCLOAK_DB_PASSWORD=<generated>
DATABASE_URL=postgres://platform:<platform-db-password>@localhost:55432/platform

# Outbound mail. Mailpit catches every message locally; its inbox is at
# http://localhost:58025.
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_FROM=no-reply@sddvault.local
SMTP_FROM_NAME=sdd-vault

# Keycloak. The realm is imported from deploy/keycloak/realm on the first start, with
# the test people of deploy/keycloak/dev: `dev` with SDD_VAULT_DEV_PASSWORD and the
# platform operator `ops` with SDD_VAULT_OPS_PASSWORD. Admin console:
# http://localhost:58080/admin with KEYCLOAK_ADMIN_USER and KEYCLOAK_ADMIN_PASSWORD.
KEYCLOAK_ISSUER=http://localhost:58080/realms/sdd-vault
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<generated>
SDD_VAULT_DEV_PASSWORD=<generated>
SDD_VAULT_OPS_PASSWORD=<generated>
MCP_RESOURCE=http://localhost:54100/mcp
APP_URL=http://localhost:5173
LANDING_URL=http://localhost:5174

# The API and the MCP server on the host. The app dev server proxies /api and /auth
# to the API, so the browser sees one origin.
API_BIND=127.0.0.1:54000
API_URL=http://localhost:54000
MCP_BIND=127.0.0.1:54100
KEYCLOAK_APP_CLIENT_SECRET=<generated>
KEYCLOAK_ADMIN_CLIENT_SECRET=<generated>
SESSION_SEALING_KEY=<generated>
