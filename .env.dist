# Copy to .env. The Makefile includes it, and every deliverable reads its settings
# from the environment.

# Host ports of the local services started by docker compose. They avoid the
# default ports so the stack can run next to other projects.
POSTGRES_PORT=55432
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
KEYCLOAK_PORT=58080

# The platform database. The role may create databases because the test suite
# clones one database per test from a migrated template.
DATABASE_URL=postgres://platform:${PLATFORM_DB_PASSWORD}@localhost:55432/platform

# Outbound mail. Mailpit catches every message locally; its inbox is at
# http://localhost:58025.
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_FROM=no-reply@spec-store.local
SMTP_FROM_NAME=spec-store

# Keycloak. The realm is imported from deploy/keycloak/realm on the first start, with
# the test people of deploy/keycloak/dev. Admin console: http://localhost:58080/admin
# (KEYCLOAK_ADMIN_USER / KEYCLOAK_ADMIN_PASSWORD). Seeded people: dev / ${SPEC_STORE_DEV_PASSWORD} and ops / ${SPEC_STORE_OPS_PASSWORD}.
KEYCLOAK_ISSUER=http://localhost:58080/realms/spec-store
MCP_RESOURCE=http://localhost:4100/mcp
APP_URL=http://localhost:5173
LANDING_URL=http://localhost:5174
SPEC_STORE_APP_CLIENT_SECRET=${KEYCLOAK_APP_CLIENT_SECRET}
SPEC_STORE_ADMIN_CLIENT_SECRET=${KEYCLOAK_ADMIN_CLIENT_SECRET}
